{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mortal-coach.local/contracts/v1/scene.schema.json",
  "type": "object",
  "properties": {
    "sceneId": { "type": "string", "maxLength": 180 },
    "reportId": { "type": "string", "maxLength": 100 },
    "playerId": { "type": "integer", "minimum": 0, "maximum": 3 },
    "position": {
      "type": "object",
      "properties": {
        "kyoku": { "type": "integer" }, "honba": { "type": "integer" },
        "junme": { "type": "integer" }, "tilesLeft": { "type": ["integer", "null"] }
      },
      "required": ["kyoku", "honba", "junme"], "additionalProperties": true
    },
    "context": { "type": "object" },
    "scores": { "type": "array", "maxItems": 4, "items": { "type": "number" } },
    "hand": { "type": "array", "minItems": 1, "maxItems": 14, "items": { "type": "string" } },
    "calls": { "type": "array" },
    "actual": { "$ref": "#/$defs/action" },
    "expected": { "$ref": "#/$defs/action" },
    "table": { "type": "object" },
    "alternatives": { "type": "array", "maxItems": 8 },
    "provider": { "enum": ["codex", "claude"] }
  },
  "required": ["sceneId", "reportId", "playerId", "position", "hand", "actual", "expected"],
  "additionalProperties": true,
  "$defs": {
    "action": {
      "type": "object",
      "properties": {
        "type": { "enum": ["dahai", "none", "reach", "chi", "pon", "kan", "ankan", "kakan", "daiminkan", "hora", "ryukyoku"] },
        "pai": { "type": "string" }, "consumed": { "type": "array", "maxItems": 4, "items": { "type": "string" } }
      },
      "required": ["type"], "additionalProperties": false
    }
  }
}
