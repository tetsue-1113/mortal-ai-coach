{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mortal-coach.local/contracts/v1/question-request.schema.json",
  "type": "object",
  "properties": {
    "scene": { "$ref": "scene.schema.json" },
    "explanation": { "type": "object" },
    "history": { "type": "array", "maxItems": 6 },
    "question": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "provider": { "enum": ["codex", "claude"] }
  },
  "required": ["scene", "question"], "additionalProperties": false
}
