{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "answer": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": ["手役", "構造", "防御", "判断", "読み"]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": ["category", "text", "evidence"],
        "additionalProperties": false
      }
    }
  },
  "required": ["answer"],
  "additionalProperties": false
}
